#!/usr/bin/make -f
include /usr/share/dpkg/default.mk

QMAKE_OPTS = DEFINES+=NO_DEBUG_ON_CONSOLE
MAKE_OPTS  = PREFIX=/usr QMAKE=qmake6 LRELEASE=/usr/lib/qt6/bin/lrelease QMAKE_OPTS="$(QMAKE_OPTS)"

override_dh_auto_configure:
	qmake6 kylin-kmre-manager.pro \
                "QMAKE_CFLAGS_RELEASE=$(CFLAGS) $(CPPFLAGS)" \
                "QMAKE_CFLAGS_DEBUG=$(CFLAGS) $(CPPFLAGS)" \
                "QMAKE_CXXFLAGS_RELEASE=$(CXXFLAGS) $(CPPFLAGS)" \
                "QMAKE_CXXFLAGS_DEBUG=$(CXXFLAGS) $(CPPFLAGS)" \
                QMAKE_LFLAGS_RELEASE="$(LDFLAGS)" \
                QMAKE_LFLAGS_DEBUG="$(LDFLAGS)" \
                QMAKE_STRIP=: PREFIX=/usr

%:
	dh $@

override_dh_install:
	dh_install --fail-missing

override_dh_auto_clean:
	[ ! -f .qmake.stash ] || $(RM) .qmake.stash
	[ ! -f manager/Makefile ] || $(RM) manager/Makefile
	[ ! -f audio/Makefile ] || $(RM) audio/Makefile
	[ ! -f filewatcher/Makefile ] || $(RM) filewatcher/Makefile
	[ ! -f gps/Makefile ] || $(RM) gps/Makefile
	[ ! -f sensors/Makefile ] || $(RM) sensors/Makefile
	[ ! -d manager/.moc ] || $(RM) -r manager/.moc
	[ ! -d manager/.obj ] || $(RM) -r manager/.obj
	[ ! -d audio/.moc ] || $(RM) -r audio/.moc
	[ ! -d audio/.obj ] || $(RM) -r audio/.obj
	[ ! -d filewatcher/.moc ] || $(RM) -r filewatcher/.moc
	[ ! -d filewatcher/.obj ] || $(RM) -r filewatcher/.obj
	[ ! -d filewatcher/.rcc ] || $(RM) -r filewatcher/.rcc
	[ ! -d sensors/.moc ] || $(RM) -r sensors/.moc
	[ ! -d sensors/.obj ] || $(RM) -r sensors/.obj
	[ ! -f Makefile ] || [ ! -f manager/Makefile ] || [ ! -f audio/Makefile ] || [ ! -f filewatcher/Makefile ] || [ ! -f sensors/Makefile ] || dh_auto_clean

override_dh_auto_build:
	dh_auto_build -- $(MAKE_OPTS) -j6

